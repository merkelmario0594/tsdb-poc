# Kafka connection for Confluent Cloud
KAFKA_BOOTSTRAP_SERVERS=lkc-yo20mn7.eu-central-1.aws.public.confluent.cloud:9092
KAFKA_API_KEY=
KAFKA_API_SECRET=
KAFKA_TOPIC=tsdb_poc

# Optional overrides
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=PLAIN

# Use these in your shell, or store them as GitHub Codespaces secrets:
# export KAFKA_BOOTSTRAP_SERVERS="lkc-yo20mn7.eu-central-1.aws.public.confluent.cloud:9092"
# export KAFKA_API_KEY="..."
# export KAFKA_API_SECRET="..."
# export KAFKA_TOPIC="tsdb_poc"
# export KAFKA_SECURITY_PROTOCOL="SASL_SSL"
# export KAFKA_SASL_MECHANISM="PLAIN"
